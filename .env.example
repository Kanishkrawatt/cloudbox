# ---- Firebase (Auth + Firestore) -------------------------------------------
# Copy to .env.local and fill from Firebase console → Project settings → Your apps,
# or run: firebase apps:sdkconfig WEB --project <project-id>
NEXT_PUBLIC_api_Key=
NEXT_PUBLIC_auth_Domain=
NEXT_PUBLIC_database_URL=
NEXT_PUBLIC_project_Id=
NEXT_PUBLIC_messaging_Sender_Id=
NEXT_PUBLIC_app_Id=
NEXT_PUBLIC_measurement_Id=

# ---- Cloudinary (file storage) ---------------------------------------------
# Firebase Storage requires the paid Blaze plan since Sept 2024, so file bytes
# live in Cloudinary instead. Free plan: 25 credits/month (~25 GB storage or
# bandwidth). Values come from the Cloudinary dashboard.
# The secret is server-only: uploads are signed by /api/cloudinary/sign.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Cron ------------------------------------------------------------------
# Shared secret for /api/deleteExpiredData, which purges expired Smart Shares.
CRON_SECRET=

# ---- Sort by Face service -------------------------------------------------
# https://github.com/Kanishkrawatt/Sort-Image-by-Face  (deployed on Render)
# Server-side only: never prefix the key with NEXT_PUBLIC_.
FACE_API_URL=https://server-yg89.onrender.com
FACE_API_KEY=
